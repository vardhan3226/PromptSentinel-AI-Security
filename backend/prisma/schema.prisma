generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ThreatLevel {
  SAFE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole @default(USER)

  scans PromptScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptScan {
  id String @id @default(cuid())

  prompt         String      @db.Text
  attackType     String?
  threatLevel    ThreatLevel
  confidence     Float
  riskScore      Float
  recommendation String?

  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}